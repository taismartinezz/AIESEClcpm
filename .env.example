# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and publishable (anon) key — safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# Service-role secret — server-side only, never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ── Google OAuth ───────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Client ID is safe to expose; secret is server-side only
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# ── OAuth providers ────────────────────────────────────────────────────────────
# Comma-separated list of enabled provider buttons on /login.
# Only include providers you have configured in the Supabase dashboard.
# Supported values: google, microsoft, github
# If unset, all three buttons are shown (legacy behaviour).
NEXT_PUBLIC_AUTH_PROVIDERS=google

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Optional — without this key, notification emails are skipped silently.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_ADDRESS=Canopy <notifications@yourdomain.com>

# ── Internal API ──────────────────────────────────────────────────────────────
# Shared secret for server-to-server calls (e.g. /api/email/send).
# Leave empty to skip the guard in development.
INTERNAL_API_SECRET=<random-secret>
