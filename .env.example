# Copy to .env.local and fill in. Every value below is a placeholder.
# This app must point at its OWN Supabase project and deployment — never reuse
# another app's keys or URLs.

# ── App URLs ──────────────────────────────────────────────────────────────────
# Public base URL of this deployment (used in invite links and emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side copy used by email templates (src/lib/email.ts).
APP_URL=http://localhost:3000

# Optional: address shown on /privacy for data requests.
NEXT_PUBLIC_PRIVACY_CONTACT=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and publishable (anon) key — safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
# Service-role secret — server-side only, never expose in the browser.
# Used by API routes (invites, emails, weekly digest) and scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ── Journal encryption ───────────────────────────────────────────────────────
# Secret used to derive each user's journal key (HKDF). Generate with:
#   openssl rand -base64 32
# Changing it later makes existing journal entries unreadable.
JOURNAL_KEY_SECRET=<random-32-byte-secret>

# ── Auth providers ────────────────────────────────────────────────────────────
# Optional comma-separated list of OAuth buttons on /login (google, microsoft, github).
# Empty = email + password only. Provider credentials are configured inside your
# Supabase dashboard, never in this app. See docs/AUTH_SETUP.md.
NEXT_PUBLIC_AUTH_PROVIDERS=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Optional — without this key, emails are logged to the console instead of sent.
RESEND_API_KEY=<resend-api-key>
# Must be an address on a domain you verified in Resend.
EMAIL_FROM=AIESEClcpm <notifications@your-domain.example>

# ── Internal / cron secrets ──────────────────────────────────────────────────
# Shared secret for server-to-server calls (e.g. /api/email/send).
INTERNAL_API_SECRET=<random-secret>
# Bearer token Vercel Cron sends to /api/cron/digest. The route fails closed without it.
CRON_SECRET=<random-secret>
# Signs the Going / Not going links in event emails (falls back to INTERNAL_API_SECRET).
RSVP_SECRET=<random-secret>

# ── Optional AI features ─────────────────────────────────────────────────────
# Enables the "fix grammar" button in Journal and Chat. Leave empty to disable.
ANTHROPIC_API_KEY=

# ── Supabase Edge Function: send-invite-email (set with `supabase secrets set`) ─
# SEND_INVITE_EMAILS=true
# INVITE_FROM=AIESEClcpm <invites@your-domain.example>
# NEXT_PUBLIC_APP_URL=https://your-deployment.example

# ── Demo data (scripts/seed.ts) ───────────────────────────────────────────────
# Password for the fictional @example.com demo accounts created by `npm run db:seed`.
# Only use against a development project.
SEED_PASSWORD=
